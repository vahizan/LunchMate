commands:
  01_setup:
    command: "echo 'Deploying with enhanced configuration...'"
  
  02_verify_nginx_config:
    command: "nginx -t && echo 'Nginx configuration is valid'"
    ignoreErrors: true
  
  03_verify_port_listening:
    command: |
      #!/bin/bash
      # Wait for the application to start
      sleep 15
      # Check if the application is listening on port 8080
      if netstat -tulpn | grep :8080 > /dev/null; then
        echo "Application is listening on port 8080"
      else
        echo "WARNING: Application is not listening on port 8080"
        # Check if the process is running
        ps aux | grep node
        # Check if there are any errors in the logs
        tail -n 50 /var/log/eb-*
      fi
    ignoreErrors: true
  
  04_verify_nginx_proxy:
    command: |
      #!/bin/bash
      # Wait for nginx to start
      sleep 10
      # Check if nginx is properly proxying requests
      if curl -s http://localhost/health | grep -q "healthy"; then
        echo "Nginx proxy to application is working correctly"
      else
        echo "WARNING: Nginx proxy to application may not be working correctly"
        # Check nginx error logs
        tail -n 50 /var/log/nginx/error.log
        # Check nginx access logs
        tail -n 10 /var/log/nginx/access.log
      fi
    ignoreErrors: true
    
  05_verify_security_groups:
    command: |
      #!/bin/bash
      # Verify security group configuration
      echo "Verifying security group configuration..."
      # Get instance ID
      INSTANCE_ID=$(curl -s http://169.254.169.254/latest/meta-data/instance-id)
      # Get security groups attached to this instance
      aws ec2 describe-instances --instance-ids $INSTANCE_ID --query "Reservations[0].Instances[0].SecurityGroups[*].GroupId" --output text --region $(curl -s http://169.254.169.254/latest/meta-data/placement/region)
      # Check if port 8080 is allowed in security groups
      echo "Security group rules should allow traffic on port 8080 from the ALB"
    ignoreErrors: true
    
  06_verify_connectivity:
    command: |
      #!/bin/bash
      # Verify connectivity between components
      echo "Testing connectivity to application..."
      # Test direct connection to application
      curl -v http://localhost:8080/health
      # Test connection through nginx proxy
      curl -v http://localhost/health
      # Check if nginx is listening on port 80
      netstat -tulpn | grep :80
    ignoreErrors: true
